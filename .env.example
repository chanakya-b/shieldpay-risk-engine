# ShieldPay — Environment Configuration
# Copy to .env and populate values for your deployment target.
# All values shown here are the defaults used in development.

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Model artifacts ───────────────────────────────────────────────────────────
# Override to point at a mounted volume in Docker / K8s
# MODEL_DIR=/app/models

# ── Inference thresholds (τ*) ─────────────────────────────────────────────────
FRAUD_THRESHOLD_STEP_UP=0.15
FRAUD_THRESHOLD_HARD_BLOCK=0.50
ABUSE_THRESHOLD_PHOTO_PROOF=0.35
ABUSE_THRESHOLD_DENY=0.65

# ── CORS ──────────────────────────────────────────────────────────────────────
# In production, replace * with your actual frontend origin:
# CORS_ORIGINS=["https://merchant.yourdomain.com"]
